SECURESTORE_DEPLOYMENT_MODE=development
SECURESTORE_LISTEN_ADDR=127.0.0.1:8080
# Production mode requires both files and serves HTTPS directly.
# SECURESTORE_TLS_CERT_FILE=/run/secrets/securestore-tls.crt
# SECURESTORE_TLS_KEY_FILE=/run/secrets/securestore-tls.key
SECURESTORE_QUARANTINE_DIR=.data/quarantine
SECURESTORE_MAX_UPLOAD_BYTES=26214400
SECURESTORE_DEFAULT_USER_QUOTA_BYTES=1073741824
SECURESTORE_STORAGE_CAPACITY_BYTES=53687091200
SECURESTORE_STORAGE_RESERVE_BYTES=5368709120
SECURESTORE_CAPACITY_RESERVATION_TTL_SECONDS=3600
SECURESTORE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURESTORE_SECURE_COOKIES=false
SECURESTORE_DATABASE_URL=postgres://securestore:change-me@127.0.0.1:54329/securestore?sslmode=disable
# Local-only delivery adapter. Verification links are private files rather than
# internet email; SMTP and Supabase are not required for this profile.
SECURESTORE_MAILBOX_DIR=.data/mailbox
SECURESTORE_PUBLIC_APP_URL=http://127.0.0.1:5173
SECURESTORE_AUDIT_HMAC_KEY_FILE=.data/audit-hmac.key
SECURESTORE_AUDIT_KEY_VERSION=v1
# JSON object containing prior verification-only keys during rotation, for
# example {"v1":"<base64>"}. Never remove a historical key while retained
# audit events still reference it.
# SECURESTORE_AUDIT_HISTORICAL_KEYS={}
SECURESTORE_AUDIT_ANCHOR_FILE=.data/audit-checkpoints.jsonl
SECURESTORE_AUDIT_ANCHOR_KEY_FILE=.data/audit-anchor.key
SECURESTORE_AUDIT_ANCHOR_PROVIDER=local
# Production remote immutable-ledger configuration. The receipt public key is
# verification-only; the external service retains its Ed25519 private key.
# SECURESTORE_AUDIT_ANCHOR_ENDPOINT=https://securestore-audit-anchor.internal:8443
# SECURESTORE_AUDIT_ANCHOR_CA_FILE=/run/secrets/audit-anchor-ca.pem
# SECURESTORE_AUDIT_ANCHOR_CLIENT_CERT_FILE=/run/secrets/securestore-anchor-client.pem
# SECURESTORE_AUDIT_ANCHOR_CLIENT_KEY_FILE=/run/secrets/securestore-anchor-client-key.pem
# SECURESTORE_AUDIT_ANCHOR_RECEIPT_PUBLIC_KEY_FILE=/run/secrets/audit-anchor-receipt-public.pem
SECURESTORE_AUDIT_ANCHOR_TIMEOUT_MS=3000
SECURESTORE_PROTECTED_DIR=.data/protected
SECURESTORE_LOCAL_KEK_FILE=.data/local-kek.key
SECURESTORE_LOCAL_KEK_VERSION=v1
# SECURESTORE_LOCAL_KEK_HISTORICAL_KEYS={"v1":"<base64>"}
SECURESTORE_KEY_PROVIDER=local
# Production remote KMS/HSM broker configuration. Mutual TLS files must be
# mounted read-only and issued to the SecureStore workload identity.
# SECURESTORE_KMS_ENDPOINT=https://securestore-key-broker.internal:8443
# SECURESTORE_KMS_KEY_ID=securestore-envelope-kek
# SECURESTORE_KMS_KEY_VERSION=v1
# SECURESTORE_KMS_CA_FILE=/run/secrets/key-broker-ca.pem
# SECURESTORE_KMS_CLIENT_CERT_FILE=/run/secrets/securestore-kms-client.pem
# SECURESTORE_KMS_CLIENT_KEY_FILE=/run/secrets/securestore-kms-client-key.pem
SECURESTORE_KMS_TIMEOUT_MS=3000
SECURESTORE_REQUIRE_PRIVILEGED_MFA=true
SECURESTORE_MFA_ENCRYPTION_KEY_FILE=.data/mfa-encryption.key
SECURESTORE_METRICS_TOKEN_FILE=.data/metrics-token.key
SECURESTORE_METRICS_STALE_AFTER_SECONDS=300
# Production may inject exactly 32 random bytes as base64 instead of using a file.
# SECURESTORE_METRICS_BEARER_TOKEN=<base64>
SECURESTORE_LOGIN_FAILURE_THRESHOLD=5
SECURESTORE_LOGIN_FAILURE_WINDOW_SECONDS=900
SECURESTORE_ACCOUNT_LOCK_SECONDS=900
SECURESTORE_AUTH_RATE_LIMIT=10
SECURESTORE_AUTH_RATE_WINDOW_SECONDS=300
SECURESTORE_REQUIRE_ADMIN_STEP_UP=true
SECURESTORE_ADMIN_STEP_UP_TTL_SECONDS=300
SECURESTORE_INSPECTION_TIMEOUT_SECONDS=15
# Local development only. Set to clamd for production-style signature scanning.
SECURESTORE_SCANNER_MODE=deterministic
SECURESTORE_CLAMD_NETWORK=tcp
SECURESTORE_CLAMD_ADDRESS=127.0.0.1:3310
SECURESTORE_CLAMD_DIAL_TIMEOUT_MS=1000
SECURESTORE_CLAMD_IO_TIMEOUT_MS=10000
SECURESTORE_CLAMD_MAX_SIGNATURE_AGE_HOURS=24
# Production: inject a base64 value containing at least 32 random bytes through
# SECURESTORE_AUDIT_HMAC_KEY and keep the file fallback for local development only.
# Production must set SECURESTORE_AUDIT_ANCHOR_PROVIDER=remote. The local
# append-only file and HMAC anchor key are development-only.
# The local KEK is development-only. Production must inject SECURESTORE_LOCAL_KEK
# through a managed KMS/HSM-backed provider rather than use the file adapter.
# The MFA encryption-key file is for local development only. Production must
# inject SECURESTORE_MFA_ENCRYPTION_KEY as exactly 32 random base64-encoded bytes
# from a secret manager; never disable privileged MFA in production.
# High-risk administrator mutations require a password plus a fresh TOTP code.
# Keep step-up enabled in production; the default authorization window is five minutes.
# ClamD TCP has no built-in authentication or transport encryption. Keep it on
# a loopback/private service network or use a restricted Unix socket; never
# expose port 3310 to an untrusted network.
