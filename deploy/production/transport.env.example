SECURESTORE_DEPLOYMENT_MODE=production
SECURESTORE_LISTEN_ADDR=0.0.0.0:8443
SECURESTORE_TLS_CERT_FILE=/run/secrets/securestore-tls.crt
SECURESTORE_TLS_KEY_FILE=/run/secrets/securestore-tls.key
SECURESTORE_PUBLIC_APP_URL=https://files.example.com
SECURESTORE_ALLOWED_ORIGINS=https://files.example.com
SECURESTORE_SECURE_COOKIES=true
SECURESTORE_DATABASE_URL=postgres://securestore@postgres.internal/securestore?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
SECURESTORE_SCANNER_MODE=clamd
SECURESTORE_KEY_PROVIDER=remote
SECURESTORE_AUDIT_ANCHOR_PROVIDER=remote
SECURESTORE_REQUIRE_PRIVILEGED_MFA=true
SECURESTORE_REQUIRE_ADMIN_STEP_UP=true
SECURESTORE_AUDIT_HMAC_KEY_FILE=/run/secrets/audit-hmac.key
SECURESTORE_MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa-encryption.key
SECURESTORE_METRICS_TOKEN_FILE=/run/secrets/metrics-token.key
