# syntax=docker/dockerfile:1.18

FROM node:24.16.0-alpine3.23 AS build

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci

COPY index.html tsconfig.app.json tsconfig.json tsconfig.node.json vite.config.ts ./
COPY src ./src
RUN npm run build

FROM nginx:1.29.8-alpine3.23

# Nginx runs without root privileges on an unprivileged port. Runtime scratch
# paths live under /tmp so the container root filesystem can remain read-only.
RUN rm -f /etc/nginx/conf.d/default.conf \
    && chown -R nginx:nginx /usr/share/nginx/html

COPY deploy/self-hosted/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /src/dist /usr/share/nginx/html

USER nginx:nginx
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
