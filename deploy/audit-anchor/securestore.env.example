SECURESTORE_AUDIT_ANCHOR_PROVIDER=remote
SECURESTORE_AUDIT_ANCHOR_ENDPOINT=https://securestore-audit-anchor.internal:8443
SECURESTORE_AUDIT_ANCHOR_CA_FILE=/run/secrets/audit-anchor-ca.pem
SECURESTORE_AUDIT_ANCHOR_CLIENT_CERT_FILE=/run/secrets/securestore-anchor-client.pem
SECURESTORE_AUDIT_ANCHOR_CLIENT_KEY_FILE=/run/secrets/securestore-anchor-client-key.pem
SECURESTORE_AUDIT_ANCHOR_RECEIPT_PUBLIC_KEY_FILE=/run/secrets/audit-anchor-receipt-public.pem
SECURESTORE_AUDIT_ANCHOR_TIMEOUT_MS=3000
